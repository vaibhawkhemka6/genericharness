# Pick whichever provider(s) you want to use. At least one is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: only set these if you're routing through a proxy/gateway instead
# of the real provider APIs. Leave blank to use the real endpoints.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# Which model to use by default (see app/config.py for id examples)
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL_ID=claude-sonnet-4-5

# CORS - comma-separated frontend origin(s) allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
